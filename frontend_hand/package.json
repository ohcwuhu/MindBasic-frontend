{
  "name": "feisi-tongxing-frontend-hand",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config demo/vite.config.mjs",
    "preview": "vite --config demo/vite.config.mjs",
    "preview:static": "python -m http.server 5179 --bind 127.0.0.1 --directory demo",
    "build": "node demo/vue/build.mjs",
    "test:unit": "node --test demo/tools/session-regressions.test.mjs demo/tools/frontend-regressions.test.mjs",
    "test:ui": "node demo/tools/ui-smoke.mjs",
    "test:live": "node demo/tools/priority-one-check.mjs && node demo/tools/priority-two-check.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.64.1",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.1.7",
    "axios": "^1.7.9",
    "html-to-image": "^1.11.13",
    "pinia": "^2.3.1",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.13"
  }
